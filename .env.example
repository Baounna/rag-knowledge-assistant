# Copy to .env and fill in.  ->  cp .env.example .env

# Which LLM runs rerank / rewrite / answers / eval-judge.
#   ollama     local model, free, no key, nothing leaves the machine
#   anthropic  Claude (paid) -- better citation discipline and refusals
#   auto       use Claude if a key is set, else fall back to Ollama
LLM_PROVIDER=auto
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434

# Only needed when LLM_PROVIDER is anthropic (or auto with a key present)
ANTHROPIC_API_KEY=

# Model roles. Cheap+fast for the high-volume calls, strong for the answer.
# (See README "Model choice" for why these are split.)
MODEL_ANSWER=claude-sonnet-5
MODEL_RERANK=claude-haiku-4-5
MODEL_REWRITE=claude-haiku-4-5
MODEL_JUDGE=claude-opus-5

# Embeddings. fastembed = local ONNX, no key, no container (default).
# Alternatives: ollama (local, needs the container) | voyage | openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Postgres (slice 2) — docker compose up -d brings this up
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Retrieval knobs — tune these against `make eval`, do not guess them
RETRIEVAL_TOP_K=20          # candidates fetched from each index
RERANK_TOP_N=5              # chunks that actually reach the prompt
MIN_CONFIDENCE=0.35         # refuse below this rerank confidence; 0 disables the gate

# Query rewriting and reranking are one extra model call each. They improve
# retrieval and cost cents on a hosted model -- but on a local CPU model they
# turn a ~20s answer into minutes, so they default OFF when LLM_PROVIDER=ollama.
# ENABLE_REWRITE=true
# ENABLE_RERANK=true
CHUNK_TARGET_WORDS=350
CHUNK_MAX_WORDS=500
CHUNK_OVERLAP_SENTENCES=2

# Per-user limits (rolling 24h window)
DAILY_QUESTION_LIMIT=100
DAILY_COST_LIMIT_CENTS=200

# Set false in production once accounts are provisioned
ALLOW_SIGNUP=true

# Set COOKIE_SECURE=true once deployed behind HTTPS
COOKIE_SECURE=false

# Blended $/1k tokens used to charge the per-user cost ceiling.
# Sonnet 5 is $3/1M in, $15/1M out -> ~0.06c/1k in, 0.3c/1k out.
CENTS_PER_1K_TOKENS=0.6

# Host port for the app (container always listens on 8501)
APP_PORT=8502
